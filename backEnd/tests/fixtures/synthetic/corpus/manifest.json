  "paraphrase_pairs": [
    {
      "id": "P1",
      "exact": {
        "doc_id": "SYN_PUB_A",
        "page": 2,
        "text": "Assets in class 57.0 have a class life of 9 years and a GDS recovery period of 5 years."
      },
      "paraphrase": {
        "doc_id": "SYN_PUB_C",
        "page": 2,
        "text": "Equipment and fixtures used by a business that sells goods to customers or provides personal services are generally depreciated over five years."
      }
    },
    {
      "id": "P2",
      "exact": {
        "doc_id": "SYN_PUB_A",
        "page": 2,
        "text": "Asset class 00.3 covers land improvements such as sidewalks, fences and parking areas, with a 15-year GDS recovery period."
      },
      "paraphrase": {
        "doc_id": "SYN_PUB_C",
        "page": 2,
        "text": "Paving, walkways, fencing and outdoor lighting placed on the land generally recover over fifteen years."
      }
    },
    {
      "id": "P3",
      "exact": {
        "doc_id": "SYN_PUB_A",
        "page": 2,
        "text": "Asset class 00.11 covers office furniture, fixtures and equipment such as desks, files and safes. It has a class life of 10 years and a GDS recovery period of 7 years."
      },
      "paraphrase": {
        "doc_id": "SYN_PUB_C",
        "page": 3,
        "text": "Desks, filing cabinets and other furniture used in an office are generally depreciated over seven years."
      }
    },
    {
      "id": "P4",
      "exact": {
        "doc_id": "SYN_PUB_B",
        "page": 1,
        "text": "Section 1245 property generally means depreciable personal property, including machinery, equipment and certain fixtures that are not structural components of a building."
      },
      "paraphrase": {
        "doc_id": "SYN_PUB_C",
        "page": 2,
        "text": "Items that can be removed without damaging the building, such as tack-down carpet, are usually treated as personal property rather than as part of the structure."
      }
    },
    {
      "id": "P5",
      "exact": {
        "doc_id": "SYN_PUB_A",
        "page": 4,
        "text": "Residential rental property is recovered over 27.5 years and nonresidential real property over 39 years, using the straight line method."
      },
      "paraphrase": {
        "doc_id": "SYN_PUB_C",
        "page": 3,
        "text": "Apartment buildings are written off over twenty-seven and a half years, while offices and stores take thirty-nine years."
      }
    }
  ]
