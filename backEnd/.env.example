# Settings names for backEnd/.env (read only when BASIS_ENV=dev; every other environment
# takes them from the process environment). Names only: fill values locally, never commit
# them. The full list, defaults and validation rules are in basis/config.py.

# Database, Temporal, storage, auth
DATABASE_URL=
TEMPORAL_ADDRESS=
TEMPORAL_NAMESPACE=
TEMPORAL_API_KEY=
GCS_BUCKET=
FIREBASE_PROJECT_ID=
STUDY_BUDGET_USD=
# Browser origins allowed to call the API (CORS), comma-separated; docs/deploy/STAGING.md
CORS_ALLOWED_ORIGINS=

# Model providers
OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT_NAME=
AZURE_OPENAI_VISION_DEPLOYMENT=
AZURE_OPENAI_TEXT_DEPLOYMENT=
ANTHROPIC_API_KEY=
ANTHROPIC_EFFORT=
LLM_PRIMARY=
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
AZURE_DOCUMENT_INTELLIGENCE_KEY=

# Per-photo vision step (defaults: EVAL_REPORT section 12.1)
# VISION_MODEL default gpt-6.1-sol; VISION_PHOTO_MODE default decomposed (or single);
# VISION_REASONING_EFFORT default low; VISION_MAX_TOKENS default 6000 on an OpenAI
# reasoning model, else 1200.
VISION_MODEL=
VISION_PHOTO_MODE=
VISION_REASONING_EFFORT=
VISION_MAX_TOKENS=

# Per-class count fusion (defaults: EVAL_REPORT section 15). VISION_COUNT_FUSION default
# per_class (or off): the countables call also runs on VISION_FUSION_MODEL (default
# claude-opus-5-5, needs ANTHROPIC_API_KEY) at VISION_FUSION_REASONING_EFFORT (default
# medium). Applies to VISION_PHOTO_MODE=decomposed only.
VISION_COUNT_FUSION=
VISION_FUSION_MODEL=
VISION_FUSION_REASONING_EFFORT=

# Room step (defaults: EVAL_REPORT section 16.5). ROOM_RECONCILE default true (false: assets
# from the per-photo components); ROOM_PROMPT_VERSION default v3 (room_inventory);
# ROOM_MODEL default claude-sonnet-5-5; ROOM_REASONING_EFFORT default low;
# ROOM_SINGLE_PHOTO default per_photo (or reconcile); ROOM_MATERIALS default sensitive
# (or disagree, none); the second look runs on ROOM_MATERIALS_MODEL (default
# claude-sonnet-5-5) at ROOM_MATERIALS_REASONING_EFFORT (default low), set apart from
# ROOM_MODEL (EVAL_REPORT 28.2: a cheaper reconciler, the second look kept on Sonnet).
ROOM_RECONCILE=
ROOM_PROMPT_VERSION=
ROOM_MODEL=
ROOM_REASONING_EFFORT=
ROOM_SINGLE_PHOTO=
ROOM_MATERIALS=
ROOM_MATERIALS_MODEL=
ROOM_MATERIALS_REASONING_EFFORT=

# Room-stage options measured but off (EVAL_REPORT 26.10 and 29; confirm on a second client
# package before switching them on). ROOM_STEP_MODE default reconcile (room_call: one
# room_photos_inventory/v2 call per interior room on ROOM_CALL_MODEL, default
# claude-opus-5-5, at ROOM_CALL_REASONING_EFFORT, default high; exterior, parking and
# mechanical rooms keep the reconcile path). MATERIALS_SECOND_LOOK default per_photo
# (surface_crops: Mask2Former wall/floor/ceiling crops asked on SURFACE_CROP_MODEL, default
# claude-sonnet-5-5, at SURFACE_CROP_REASONING_EFFORT, default low; SURFACE_SEGMENTER
# default local, the measured checkpoint on the CPU, or replicate, not measured, which
# needs REPLICATE_API_TOKEN and uses SURFACE_SEGMENTER_REPLICATE_VERSION).
ROOM_STEP_MODE=
ROOM_CALL_MODEL=
ROOM_CALL_REASONING_EFFORT=
MATERIALS_SECOND_LOOK=
SURFACE_CROP_MODEL=
SURFACE_CROP_REASONING_EFFORT=
SURFACE_SEGMENTER=
SURFACE_SEGMENTER_REPLICATE_VERSION=

# Appraisal extraction (EVAL_REPORT section 33.5). EXTRACTION_METHOD default grounded: one
# structured call on EXTRACTION_GROUNDED_MODEL (default gpt-6.1-sol) at
# EXTRACTION_GROUNDED_REASONING_EFFORT (default low; gpt-6.1-sol refuses none) with
# EXTRACTION_GROUNDED_MAX_TOKENS (default 32000) reads every field with its verbatim quote
# from Azure DI's page text; when it cannot run or its call fails, the pipeline reads the
# document instead. EXTRACTION_METHOD=pipeline is the reading before section 33 (Azure DI
# pairs, the text layer, then the TEXT_MODEL fallback). A UAD 3.6 XML/ZIP upload is read by
# the XML reader either way.
EXTRACTION_METHOD=
EXTRACTION_GROUNDED_MODEL=
EXTRACTION_GROUNDED_REASONING_EFFORT=
EXTRACTION_GROUNDED_MAX_TOKENS=

# Text steps (defaults: EVAL_REPORT section 17.3). TEXT_MODEL default gpt-6-luna (the
# extraction fallback) at EXTRACTION_REASONING_EFFORT default low; EXTRACTION_FALLBACK_MAX_TOKENS
# default 8000 on an OpenAI reasoning model, else 800. CLASSIFY_MODEL default
# claude-sonnet-5-5 at CLASSIFY_REASONING_EFFORT default low (an OpenAI reasoning model
# needs CLASSIFY_REASONING_EFFORT=none; gpt-6.1-sol cannot run the classifier).
TEXT_MODEL=
EXTRACTION_REASONING_EFFORT=
EXTRACTION_FALLBACK_MAX_TOKENS=
CLASSIFY_MODEL=
CLASSIFY_REASONING_EFFORT=

# SAM 3 object localization (Replicate). Unset token: localization is skipped per photo.
REPLICATE_API_TOKEN=
SAM3_REPLICATE_VERSION=
LOCALIZER_CONCURRENCY=
