# Settings names for backEnd/.env (read only when BASIS_ENV=dev; every other environment
# takes them from the process environment). Names only: fill values locally, never commit
# them. The full list, defaults and validation rules are in basis/config.py.

# Database, Temporal, storage, auth
DATABASE_URL=
TEMPORAL_ADDRESS=
TEMPORAL_NAMESPACE=
TEMPORAL_API_KEY=
GCS_BUCKET=
FIREBASE_PROJECT_ID=
STUDY_BUDGET_USD=

# Model providers
OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT_NAME=
AZURE_OPENAI_VISION_DEPLOYMENT=
AZURE_OPENAI_TEXT_DEPLOYMENT=
ANTHROPIC_API_KEY=
ANTHROPIC_EFFORT=
LLM_PRIMARY=
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
AZURE_DOCUMENT_INTELLIGENCE_KEY=

# Per-photo vision step (defaults: EVAL_REPORT section 12.1)
# VISION_MODEL default gpt-6.1-sol; VISION_PHOTO_MODE default decomposed (or single);
# VISION_REASONING_EFFORT default low; VISION_MAX_TOKENS default 6000 on an OpenAI
# reasoning model, else 1200.
VISION_MODEL=
VISION_PHOTO_MODE=
VISION_REASONING_EFFORT=
VISION_MAX_TOKENS=

# Per-class count fusion (defaults: EVAL_REPORT section 15). VISION_COUNT_FUSION default
# per_class (or off): the countables call also runs on VISION_FUSION_MODEL (default
# claude-opus-5-5, needs ANTHROPIC_API_KEY) at VISION_FUSION_REASONING_EFFORT (default
# medium). Applies to VISION_PHOTO_MODE=decomposed only.
VISION_COUNT_FUSION=
VISION_FUSION_MODEL=
VISION_FUSION_REASONING_EFFORT=

# Room step (defaults: EVAL_REPORT section 16.5). ROOM_RECONCILE default true (false: assets
# from the per-photo components); ROOM_PROMPT_VERSION default v3 (room_inventory);
# ROOM_MODEL default claude-sonnet-5-5; ROOM_REASONING_EFFORT default low;
# ROOM_SINGLE_PHOTO default per_photo (or reconcile); ROOM_MATERIALS default sensitive
# (or disagree, none).
ROOM_RECONCILE=
ROOM_PROMPT_VERSION=
ROOM_MODEL=
ROOM_REASONING_EFFORT=
ROOM_SINGLE_PHOTO=
ROOM_MATERIALS=

# Text steps (defaults: EVAL_REPORT section 17.3). TEXT_MODEL default gpt-6-luna (the
# extraction fallback) at EXTRACTION_REASONING_EFFORT default low; EXTRACTION_FALLBACK_MAX_TOKENS
# default 8000 on an OpenAI reasoning model, else 800. CLASSIFY_MODEL default
# claude-sonnet-5-5 at CLASSIFY_REASONING_EFFORT default low (an OpenAI reasoning model
# needs CLASSIFY_REASONING_EFFORT=none; gpt-6.1-sol cannot run the classifier).
TEXT_MODEL=
EXTRACTION_REASONING_EFFORT=
EXTRACTION_FALLBACK_MAX_TOKENS=
CLASSIFY_MODEL=
CLASSIFY_REASONING_EFFORT=

# SAM 3 object localization (Replicate). Unset token: localization is skipped per photo.
REPLICATE_API_TOKEN=
SAM3_REPLICATE_VERSION=
LOCALIZER_CONCURRENCY=
