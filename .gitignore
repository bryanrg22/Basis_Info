.env
.env.*
*.env
.env.local
.env.development.local
.env.test.local
.env.production.local
# The names-only template is committed (no values).
!backEnd/.env.example

# Service Account & Firebase credentials (never commit these!)
*-firebase-adminsdk-*.json
devtest/*-firebase-adminsdk-*.json
*-sa-key.json
*-service-account.json
credentials/*.json
secrets/

